rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Todo cerrado al cliente ────────────────────────────────────────────────
    // Desde la migración del PIN al servidor (docs/PAXG_AUDIT.md §P5) el navegador NO habla con Firestore: perfiles,
    // sesiones y portfolio pasan por la API (Admin SDK, que ignora estas reglas) con sesión y PIN verificado en el servidor.
    // Cualquier acceso directo con la clave web queda denegado.
    //
    // ⚠️ Publicar estas reglas SOLO después de desplegar la versión nueva del sitio y de confirmar que el login por PIN
    //    funciona; con el sitio viejo (que leía Firestore directo) dejarían la app sin acceso.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

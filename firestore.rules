rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Validación de esquema (P5) ─────────────────────────────────────────────
    // La app usa PIN (no Firebase Auth), así que estas reglas NO autentican: limitan QUÉ se puede escribir.
    // Riesgo residual documentado en docs/PAXG_AUDIT.md (§P5): cualquiera con la config web puede leer/borrar operaciones.
    function validOp(d) {
      return d.keys().hasOnly(['date', 'symbol', 'type', 'amount_usd', 'price', 'units', 'fee', 'exchange', 'notes', 'userId', 'created_at'])
        && d.date is string && d.date.size() <= 32
        && d.symbol is string && d.symbol.size() >= 2 && d.symbol.size() <= 10
        && d.type in ['BUY', 'SELL']
        && d.amount_usd is number && d.amount_usd >= 0 && d.amount_usd <= 1000000000
        && d.price is number && d.price >= 0
        && d.units is number && d.units >= 0
        && (!('exchange' in d) || (d.exchange is string && d.exchange.size() <= 50))
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 500));
    }

    // Operaciones del portfolio — el cliente React crea, lee y borra; nunca edita
    match /portfolio_operations/{docId} {
      allow read:   if true;
      allow create: if validOp(request.resource.data);
      allow update: if false;
      allow delete: if true;
    }

    // Perfiles de usuario (hash SHA-256 del PIN): se crea una vez y solo se puede cambiar la lista de monedas.
    // (El hash de un PIN corto es débil: el PIN es una comodidad, no una barrera de seguridad.)
    match /user_profiles/{userId} {
      allow read:   if true;
      allow create: if request.resource.data.keys().hasOnly(['pinHash', 'createdAt'])
                    && request.resource.data.pinHash is string
                    && request.resource.data.pinHash.size() == 64;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cryptos'])
                    && request.resource.data.cryptos is list
                    && request.resource.data.cryptos.size() <= 20;
      allow delete: if false;
    }

    // Historial de decisiones — solo lectura pública (escritura solo desde Functions)
    match /decisions/{docId} {
      allow read:  if true;
      allow write: if false;
    }

    // Snapshots horarios de mercado — solo el servidor (Admin SDK) escribe y lee.
    // (Sin regla el cliente ya estaría denegado por defecto; se deja explícito. Las reglas no se
    // despliegan desde deploy.yml: aplicar con `firebase deploy --only firestore:rules`.)
    match /snapshots/{docId} {
      allow read, write: if false;
    }

    // Resultados etiquetados de las señales (P4) — solo el servidor (Admin SDK)
    match /outcomes/{docId} {
      allow read, write: if false;
    }

    // Cachés internas de la Function — solo acceso desde el servidor (Admin SDK)
    match /_cache/{docId} {
      allow read, write: if false;
    }
    match /_ai_cache/{docId} {
      allow read, write: if false;
    }
    match /_zone_state/{docId} {
      allow read, write: if false;
    }
    match /push_subscriptions/{docId} {
      allow read, write: if false;
    }
  }
}
